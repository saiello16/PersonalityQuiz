<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PersonalityQuiz.ResultPage"
    Title="Your Result">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" HorizontalOptions="Center">

            <Label 
                x:Name="TitleLabel"
                Text="Your Match"
                FontSize="28"
                HorizontalTextAlignment="Center"
                FontAttributes="Bold"/>

            <Image 
                x:Name="CharacterImage"
                HeightRequest="250"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label 
                x:Name="CharacterName"
                FontSize="24"
                HorizontalTextAlignment="Center"
                FontAttributes="Bold"/>

            <Label 
                x:Name="CharacterDescription"
                FontSize="18"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,0" />

            <Button 
                Text="Retake Quiz"
                HorizontalOptions="Center"
                Clicked="OnRetakeClicked"
                Padding="12,6"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
